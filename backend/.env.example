# AI provider configuration. Copy this file to .env and replace the placeholder locally.
AI_PROVIDER=groq
GROQ_API_KEY=
# Optional ordered fallback keys, separated by commas. The legacy key above is
# appended as a final fallback when it is not already included in this list.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=30000
PORT=5001
